# TuneScribe backend — FastAPI on port 8000 (NOT 3000, NO /api suffix)

# Web on same machine:
# EXPO_PUBLIC_API_URL=http://localhost:8000

# iPhone personal hotspot (PC usually gets 172.20.10.2 — verify with ipconfig on Windows):
# EXPO_PUBLIC_API_URL=http://172.20.10.2:8000

# Home Wi-Fi (use your PC's IPv4 from ipconfig):
# EXPO_PUBLIC_API_URL=http://192.168.1.42:8000
